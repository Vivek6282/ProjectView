# TiDB Cloud (MySQL Compatible) Connection String
# Example: mysql://user:password@host:port/dbname?ssl-mode=VERIFY_IDENTITY
# Leave commented out for local development with SQLite
# DATABASE_URL=mysql://user:password@host:port/dbname

# Security & Debug
SECRET_KEY=your_long_random_production_secret_key_here
DEBUG=True

# Host & CSRF Configuration (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,projectview.onrender.com
CSRF_TRUSTED_ORIGINS=https://projectview.onrender.com

# Media storage path (points to persistent disk on Render e.g. /var/data/media)
# MEDIA_ROOT=/var/data/media
