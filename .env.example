# TiDB Cloud (MySQL Compatible) Connection String
# Example: mysql://user:password@host:port/dbname?ssl-mode=VERIFY_IDENTITY
# Leave commented out for local development with SQLite
# DATABASE_URL=mysql://user:password@host:port/dbname

# Security & Debug
SECRET_KEY=your_long_random_production_secret_key_here
DEBUG=True

# Host & CSRF Configuration (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,projectview.onrender.com
CSRF_TRUSTED_ORIGINS=https://projectview.onrender.com

# Media storage configuration
# Option 1 (Recommended / Free Tier): Cloudflare R2 (S3-Compatible Object Storage)
# Leave unset to fall back to local disk storage for local development
# AWS_STORAGE_BUCKET_NAME=projectview-uploads
# AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
# AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
# AWS_S3_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# Option 2 (Paid Render Tier): Render Persistent Disk
# MEDIA_ROOT=/var/data/media
